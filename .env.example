# ==============================================================================
# Sentinels Configuration Template
# Copy this file to .env and configure your environment
# ==============================================================================

# LLM Provider: "ollama" (local offline), "azure", or "openai"
LLM_PROVIDER=ollama

# Local Ollama Settings (Zero-Cost / Offline)
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# Azure OpenAI Settings (Optional Cloud Engine)
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_GPT_DEPLOYMENT=gpt-4o-mini

# Standard OpenAI Settings (Optional)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# Logging Verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
